  "rules": [
    "[environment] on_top_of: IF Y selected_in layer_n AND Z selected_in layer_(n-1) THEN Y on_top_of Z",
    "[environment] on_table: IF Y selected_in layer_1 AND layer_1 rests_on S THEN Y on_top_of S",
    "[environment] is_base: IF Y selected_in layer_1 THEN Y is base",
    "[environment] is_top: IF all objects placed AND Y selected_in the last layer THEN Y is top",
    "[physics] under: IF Y on_top_of Z THEN Z under Y",
    "[physics] bigger_than: IF Y.volume > X.volume THEN Y bigger_than X",
    "[physics] smaller_than: IF Y bigger_than X THEN X smaller_than Y",
    "[physics] bigger_from_smaller: IF Y smaller_than X THEN X bigger_than Y",
    "[physics] bigger_on_smaller: IF Y on_top_of Z AND Y bigger_than Z THEN Y bigger_on_smaller Z (Y is bigger than Z but placed on top of it: this breaks the order \"bigger objects go lower\")",
    "[algorithm] placed: IF Y selected_in any layer THEN Y is placed",
    "[algorithm] candidate_in: IF layer_n has a selection AND X not selected in any layer < n THEN X candidate_in layer_n",
    "[algorithm] best_candidate: IF Y selected_in layer_n THEN Y best_candidate_in layer_n",
    "[algorithm] preferred_over: IF Y best_candidate_in layer_n AND X candidate_in layer_n AND X != Y THEN Y preferred_over X (in layer_n)"
  ]
